# Copy this file to .env and fill in your actual values.
# NEVER commit .env — it is in .gitignore.
#
# Rotate all keys below if you suspect they have been exposed.

# Supabase project URL
SUPABASE_URL=https://<your-project-ref>.supabase.co

# Supabase service role key (bypasses RLS — treat as a private server secret)
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# Supabase JWT secret — Supabase dashboard → Settings → API → JWT Settings → JWT Secret
# Used by the backend to verify Bearer tokens from the mobile app.
SUPABASE_JWT_SECRET=<your-jwt-secret>

# Supabase anon (public) key — used only for local dev tools, NOT needed by the API server
SUPABASE_ANON_KEY=<your-anon-key>


# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000

# Set to "production" on Render; "development" locally
ENVIRONMENT=development

# Server port (Render sets this automatically)
PORT=8000

# Groq EchoCoach configuration (using Moonshot AI Kimi on Groq)
GROQ_API_KEY=<your-groq-api-key>
COACH_LLM_MODEL=moonshotai/kimi-k2-instruct-0905
COACH_LLM_MODEL_BACKUP=openai/gpt-oss-120b
# Debrief uses this configured ceiling; intention refinement caps it at 3 seconds.
COACH_LLM_TIMEOUT_SECONDS=5
