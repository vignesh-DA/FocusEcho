{
  "manifest_version": 3,
  "name": "FocusEcho",
  "version": "2.0.0",
  "description": "Intention-aware focus coach for your browser. Detects distraction and escalates interventions tied to your declared goal.",
  "minimum_chrome_version": "102",

  "permissions": [
    "storage",
    "idle",
    "alarms",
    "tabs",
    "webNavigation",
    "scripting"
  ],

  "optional_host_permissions": ["<all_urls>"],

  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "_comment": "CONFIRM: replace focusecho-app.vercel.app with your actual Vercel project URL",
      "matches": [
        "https://focusecho-app.vercel.app/*",
        "http://localhost:3000/*",
        "http://localhost:5173/*"
      ],
      "js": ["src/content/bridge.js"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16":  "src/assets/icons/icon-16.png",
      "48":  "src/assets/icons/icon-48.png",
      "128": "src/assets/icons/icon-128.png"
    },
    "default_title": "FocusEcho"
  },

  "options_page": "src/options/options.html"
}
