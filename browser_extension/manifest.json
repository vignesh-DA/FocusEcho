{
  "manifest_version": 3,
  "name": "FocusEcho Browser Monitor",
  "version": "1.0.0",
  "description": "Sends configured browser distraction events to the FocusEcho web app.",
  "permissions": ["tabs", "webNavigation", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {"default_title": "FocusEcho Browser Monitor"}
}
